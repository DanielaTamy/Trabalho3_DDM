<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz_criatura"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/menu_criatura"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@+id/campo_nome_criatura"
            android:text="@string/rotulo_criatura" />
        <EditText
            android:id="@id/campo_nome_criatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/exemplo_criatura"
            android:inputType="textPersonName"
            android:maxLines="1" />
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:onClick="buscarCriatura"
            android:text="@string/buscar" />
        <ProgressBar
            android:id="@+id/progresso_criatura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/carregando"
            android:visibility="gone" />
        <TextView
            android:id="@+id/resultado_criatura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="18sp" />
        <ImageView
            android:id="@+id/imagem_criatura"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
        <TextView
            android:id="@+id/aviso_imagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/imagem_indisponivel"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>